{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kndsb/board-member",
  "version": "1.6.0",
  "title": "KNDSB Bestuurslid",
  "category": "widgets",
  "icon": "admin-users",
