{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kndsb/board-vacancy",
  "version": "1.6.0",
  "title": "KNDSB Bestuursvacature",
  "category": "widgets",
  "icon": "plus-alt2",
