{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "kndsb/logo-card",
  "version": "1.0.0",
  "title": "KNDSB logokaart",
  "category": "design",
  "icon": "format-image",
  "description": "Logo met optionele link voor sponsor, fonds, partner of organisatie.",
  "textdomain": "kndsb",
  "parent": ["kndsb/logo-grid"],
  "attributes": {
    "name": { "type": "string", "default": "Organisatienaam" },
    "url": { "type": "string", "default": "" },
    "imageId": { "type": "number" },
    "imageUrl": { "type": "string", "default": "" },
    "imageAlt": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "reusable": true },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}
