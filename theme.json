{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "blue", "name": "KNDSB blauw", "color": "#063c78" },
        { "slug": "primary-dark", "name": "Donkerblauw", "color": "#003f70" },
        { "slug": "orange", "name": "KNDSB oranje", "color": "#f37020" },
        { "slug": "red", "name": "KNDSB rood", "color": "#e63328" },
        { "slug": "ink", "name": "Tekstkleur", "color": "#17202a" },
        { "slug": "blue-white", "name": "Gebroken blauw-wit", "color": "#f1f6fa" },
        { "slug": "white", "name": "Wit", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%"],
      "spacingSizes": [
        { "slug": "xs", "name": "XS", "size": "8px" },
        { "slug": "s", "name": "S", "size": "16px" },
        { "slug": "m", "name": "M", "size": "24px" },
        { "slug": "l", "name": "L", "size": "32px" },
        { "slug": "xl", "name": "XL", "size": "48px" },
        { "slug": "2-xl", "name": "2XL", "size": "64px" },
        { "slug": "3-xl", "name": "3XL", "size": "80px" },
        { "slug": "4-xl", "name": "4XL", "size": "96px" }
      ]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "spacing": {
      "padding": {
        "left": "clamp(16px, 3vw, 24px)",
        "right": "clamp(16px, 3vw, 24px)"
      }
    },
    "typography": {
      "fontFamily": "basic-sans, Arial, Helvetica, sans-serif",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|orange"
        }
      }
    }
  }
}
